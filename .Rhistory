knitr::opts_chunk$set(message = FALSE)
install.packages('tidyverse')
install.packages("tidyverse")
library(tidyverse)
df <- read_csv("https://bryantstats.github.io/math421/data/all-states-history.csv")
head(df)
library(lubridate)
df$month = month(df$date)
# day of the week
df$weekday = wday(df$date)
# day of the month
df$monthday <- mday(df$date)
head(df)
df$daily_death <- case_when(
df$deathIncrease <3 ~ 'low',
df$deathIncrease <=14 ~ 'medium',
TRUE ~ 'high'
)
df$month2 <- case_when(
df$monthday <= 10 ~ "early_month",
df$monthday <= 20 ~ "mid_month",
TRUE ~ "end_month"
)
df$weekend <- case_when(
df$weekday == 1 | df$weekday == 7 ~ 1,
TRUE ~ 0
)
head(df)
library(tidyverse)
df <- df %>%
select(-totalTestsViral)
head(df)
x <- c(1:10)
# square root of x
sqrt(x)
sum(sqrt(x))
log(sum(sqrt(x)))
# log base 2 of 16
log(16, 2)
x <- c(1:10)
x <- c(1:10)
# square root of x
x %>%
sqrt()
# sum of the square roots
x %>%
sqrt() %>%
sum()
# log of the sum of the square roots
x %>%
sqrt() %>%
sum() %>%
log()
# log base 2 of 16
16 %>%
log(2)
# median positiveIncrease by month
df %>%
group_by(month) %>%
summarise(median(positiveIncrease, na.rm = TRUE))
# average positiveIncrease by month2
df %>%
group_by(month2) %>%
summarise(mean(positiveIncrease, na.rm = TRUE))
# median positiveIncrease by weekend
df %>%
group_by(weekend) %>%
summarise(median(positiveIncrease, na.rm = TRUE))
df %>%
filter(month==1|month==2) %>%
group_by(month) %>%
summarise(positve_increase = mean(positiveIncrease))
# 1. Median positiveIncrease on weekends by month
# in October and November 2020
df %>%
filter(year(date) == 2020,
month %in% c(10, 11),
weekend == 1) %>%
group_by(month) %>%
summarise(median_cases = median(positiveIncrease, na.rm = TRUE))
# 2. Average deaths by period of the month in Fall 2020
df %>%
filter(year(date) == 2020,
month %in% c(9, 10, 11)) %>%
group_by(month2) %>%
summarise(avg_death = mean(death, na.rm = TRUE))
# 3. Average hospitalizations on weekdays vs weekends
# in Summer 2020
df %>%
filter(year(date) == 2020,
month %in% c(6, 7, 8)) %>%
group_by(weekend) %>%
summarise(avg_hospitalizations =
mean(hospitalizedIncrease, na.rm = TRUE))
df %>%
filter(state == "RI",
year(date) == 2021) %>%
summarise(avg_cases = mean(positiveIncrease, na.rm = TRUE))
df %>%
filter(state == "RI",
year(date) == 2021) %>%
group_by(weekday) %>%
summarise(median_cases = median(positiveIncrease, na.rm = TRUE))
df %>%
filter(weekend == 1) %>%
group_by(month) %>%
summarise(avg_deaths = mean(deathIncrease, na.rm = TRUE)) %>%
arrange(desc(avg_deaths))
adult <- read.csv("adult_census.csv")
head(adult)
str(adult)
names(adult)
# select
adult %>%
select(age, education, occupation, hours.per.week, income)
# filter
adult %>%
filter(age >= 50)
# arrange
adult %>%
arrange(desc(age))
# mutate
adult %>%
mutate(age_group = case_when(
age < 30 ~ "Under 30",
age < 50 ~ "30-49",
TRUE ~ "50+"
))
# group_by + summarise
adult %>%
group_by(income) %>%
summarise(avg_age = mean(age))
# filter + group_by + summarise
adult %>%
filter(sex == "Female") %>%
group_by(income) %>%
summarise(avg_hours = mean(hours.per.week))
# group_by + summarise + arrange
adult %>%
group_by(education) %>%
summarise(avg_hours = mean(hours.per.week)) %>%
arrange(desc(avg_hours))
adult <- read.csv("adult_census.csv")
# 1. select
adult %>%
select(age, education, occupation, hours.per.week, income)
# 2. filter
adult %>%
filter(age >= 50)
# 3. mutate
adult %>%
mutate(age_group = case_when(
age < 30 ~ "Under 30",
age < 50 ~ "30-49",
TRUE ~ "50+"
))
# 4. summarise
adult %>%
summarise(avg_age = mean(age))
# 5. arrange
adult %>%
arrange(desc(hours.per.week))
# 6. count
adult %>%
count(income)
# 7. count + arrange
adult %>%
count(education) %>%
arrange(desc(n))
# 8. filter + count + arrange
adult %>%
filter(age >= 50) %>%
count(occupation) %>%
arrange(desc(n))
# 9. group_by + summarise
adult %>%
group_by(income) %>%
summarise(avg_age = mean(age))
# 10. filter + group_by + summarise
adult %>%
filter(sex == "Female") %>%
group_by(income) %>%
summarise(avg_hours = mean(hours.per.week))
# 11. filter + group_by + summarise + arrange
adult %>%
filter(age >= 30) %>%
group_by(education) %>%
summarise(avg_hours = mean(hours.per.week)) %>%
arrange(desc(avg_hours))
