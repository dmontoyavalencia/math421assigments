filter(state == "RI",
year(date) == 2021) %>%
group_by(weekday) %>%
summarise(median_cases = median(positiveIncrease, na.rm = TRUE))
df %>%
filter(weekend == 1) %>%
group_by(month) %>%
summarise(avg_deaths = mean(deathIncrease, na.rm = TRUE)) %>%
arrange(desc(avg_deaths))
adult <- read.csv("adult_census.csv")
head(adult)
str(adult)
names(adult)
# select
adult %>%
select(age, education, occupation, hours.per.week, income)
# filter
adult %>%
filter(age >= 50)
# arrange
adult %>%
arrange(desc(age))
# mutate
adult %>%
mutate(age_group = case_when(
age < 30 ~ "Under 30",
age < 50 ~ "30-49",
TRUE ~ "50+"
))
# group_by + summarise
adult %>%
group_by(income) %>%
summarise(avg_age = mean(age))
# filter + group_by + summarise
adult %>%
filter(sex == "Female") %>%
group_by(income) %>%
summarise(avg_hours = mean(hours.per.week))
# group_by + summarise + arrange
adult %>%
group_by(education) %>%
summarise(avg_hours = mean(hours.per.week)) %>%
arrange(desc(avg_hours))
adult <- read.csv("adult_census.csv")
# 1. select
adult %>%
select(age, education, occupation, hours.per.week, income)
# 2. filter
adult %>%
filter(age >= 50)
# 3. mutate
adult %>%
mutate(age_group = case_when(
age < 30 ~ "Under 30",
age < 50 ~ "30-49",
TRUE ~ "50+"
))
# 4. summarise
adult %>%
summarise(avg_age = mean(age))
# 5. arrange
adult %>%
arrange(desc(hours.per.week))
# 6. count
adult %>%
count(income)
# 7. count + arrange
adult %>%
count(education) %>%
arrange(desc(n))
# 8. filter + count + arrange
adult %>%
filter(age >= 50) %>%
count(occupation) %>%
arrange(desc(n))
# 9. group_by + summarise
adult %>%
group_by(income) %>%
summarise(avg_age = mean(age))
# 10. filter + group_by + summarise
adult %>%
filter(sex == "Female") %>%
group_by(income) %>%
summarise(avg_hours = mean(hours.per.week))
# 11. filter + group_by + summarise + arrange
adult %>%
filter(age >= 30) %>%
group_by(education) %>%
summarise(avg_hours = mean(hours.per.week)) %>%
arrange(desc(avg_hours))
